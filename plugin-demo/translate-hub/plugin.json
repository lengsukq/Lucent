          "subtitle": "Auto-translate current clipboard text between your primary and secondary languages"
        },
        "input-translate": {
          "title": "Input Translate & Dictionary Lookup",
          "subtitle": "Look up single words with phonetics/definitions or translate sentences across enabled engines"
        },
        "vocab-book": {
          "title": "Browse Vocabulary Book",
          "subtitle": "Search, speak, or manage saved words with 0ms launcher index sync"
        },
        "translate-history": {
          "title": "Recent Translation History",
          "subtitle": "Inspect recent translations, copy results, speak aloud, or save to Vocabulary"
        },
        "export-anki": {
          "title": "Export Vocabulary to Anki (.tsv) & CSV",
