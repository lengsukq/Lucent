{
  "schemaVersion": 3,
  "id": "translate-hub",
  "name": "流光译站 · 有道/苹果与多源大模型翻译",
  "version": "1.1.0",
  "description": "支持跨应用划词即译、截图/图片离线 OCR 翻译、网易有道翻译（默认优先）、苹果自带翻译、OpenAI / Google Gemini 通用协议大模型、本地 Ollama 与公共通道并行对比及生词本导出",
  "mode": "view",
  "timeoutSeconds": 20,
  "keywords": ["tr", "fy", "trans", "translate", "dict", "翻译", "划词", "词典", "生词本"],
  "entry": "bin/translate-hub",
  "author": "Lucent Official",
  "icon": "icon.svg",
  "accentColor": "purple",
  "categoryTag": "翻译词典",
  "capabilities": ["selection", "clipboard", "ocr", "audio"],
  "resourceScopes": ["network", "filesystem"],
  "accepts": ["text", "image"],
  "commands": [
    {
      "id": "selection-translate",
      "title": "划词即译（翻译当前选中文本）",
      "subtitle": "经 Host Bridge 自动读取前台应用选中文本（无选区时回退剪贴板）并多源互译",
      "keywords": ["划词翻译", "选中翻译", "trsel", "selection translate"],
      "icon": "text.cursor",
      "arguments": ["--selection"],
      "passQuery": false
    },
    {
      "id": "clipboard-translate",
      "title": "剪贴板即译",
      "subtitle": "直接读取当前系统剪贴板文本并在第一/第二语言之间自动互译",
      "keywords": ["剪贴板翻译", "复制翻译", "trclip", "clipboard translate"],
      "icon": "doc.on.clipboard",
      "arguments": ["--clipboard"],
      "passQuery": false
    },
    {
      "id": "input-translate",
      "title": "输入互译与单词词典查词",
      "subtitle": "输入单词展示音标、词性与释义，输入长句调用已启用引擎并行翻译",
      "keywords": ["输入翻译", "查词", "词典", "dict", "lookup"],
      "icon": "character.book.closed.fill",
      "arguments": ["--input"],
      "passQuery": true
    },
    {
      "id": "vocab-book",
      "title": "浏览生词本与收藏夹",
      "subtitle": "查看、检索、朗读已收藏的单词和译文，并同步 ⌥Space 免前缀检索索引",
      "keywords": ["生词本", "单词本", "vocab", "wordbook"],
      "icon": "star.square.on.square.fill",
      "arguments": ["--vocab"],
      "passQuery": true
    },
    {
      "id": "translate-history",
      "title": "查看最近翻译历史",
      "subtitle": "回看最近翻译记录，支持一键复制译文、语音朗读或补入生词本",
      "keywords": ["翻译历史", "trhist", "translation history"],
      "icon": "clock.arrow.circlepath",
      "arguments": ["--history"],
      "passQuery": true
    },
    {
      "id": "export-anki",
      "title": "导出生词本为 Anki 卡片 (.tsv) 与 CSV",
      "subtitle": "将生词本一键导出为可直接导入 Anki 的 TSV 背单词卡片与 UTF-8 CSV 表格",
      "keywords": ["导出anki", "导出生词本", "anki", "export vocab"],
      "icon": "square.and.arrow.up.fill",
      "arguments": ["--export"],
      "passQuery": false
    }
  ],
  "config": [
    {
      "key": "primaryLang",
      "label": "第一语言（母语）",
      "type": "select",
      "defaultValue": "zh-Hans",
      "options": ["zh-Hans", "zh-Hant", "en", "ja", "ko", "fr", "de", "es"],
      "section": "语言与展示内容"
    },
    {
      "key": "secondaryLang",
      "label": "第二语言（默认互译目标）",
      "type": "select",
      "defaultValue": "en",
      "options": ["en", "zh-Hans", "zh-Hant", "ja", "ko", "fr", "de", "es"],
      "section": "语言与展示内容"
    },
    {
      "key": "primaryEngine",
      "label": "首选展示引擎（决定主译文与排序首位）",
      "type": "select",
      "defaultValue": "auto",
      "options": ["auto", "youdao", "openai", "gemini", "ollama", "apple", "free"],
      "helpText": "auto 默认优先级：网易有道 → OpenAI → Gemini → Ollama → 苹果翻译 → 内置通道",
      "section": "语言与展示内容"
    },
    {
      "key": "autoCopyResult",
      "label": "翻译完成后自动将首选译文写入剪贴板",
      "type": "boolean",
      "defaultValue": "false",
      "section": "语言与展示内容"
    },
    {
      "key": "showDictionaryCard",
      "label": "展示单词词典音标与释义卡片",
      "type": "boolean",
      "defaultValue": "true",
      "section": "语言与展示内容"
    },
    {
      "key": "showMarkdownQuote",
      "label": "展示顶部原文引用与摘要预览",
      "type": "boolean",
      "defaultValue": "true",
      "section": "语言与展示内容"
    },
    {
      "key": "showTranslateActions",
      "label": "每条译文显示朗读 / 加入生词本按钮",
      "type": "boolean",
      "defaultValue": "true",
      "section": "语言与展示内容"
    },
    {
      "key": "showEngineErrors",
      "label": "显示引擎未就绪或调用失败提示",
      "type": "boolean",
      "defaultValue": "true",
      "helpText": "例如未下载苹果离线语言包或未填 API Key 时在结果末尾给出提示",
      "section": "语言与展示内容"
    },
    {
      "key": "enableYoudaoTranslate",
      "label": "启用网易有道翻译（免密钥 · 默认优先）",
      "type": "boolean",
      "defaultValue": "true",
      "helpText": "参考 Easydict 接入网易有道 Web 翻译接口，中英日韩多语种直译准确",
      "section": "翻译引擎开关"
    },
    {
      "key": "enableAppleTranslate",
      "label": "启用苹果自带翻译（macOS 系统离线翻译）",
      "type": "boolean",
      "defaultValue": "false",
      "helpText": "需 macOS 26+ 并在「系统设置 → 通用 → 语言与地区 → 翻译语言」下载对应语种离线包",
      "section": "翻译引擎开关"
    },
    {
      "key": "enableFreeEngine",
      "label": "启用内置免配置公共词典与翻译通道",
      "type": "boolean",
      "defaultValue": "true",
      "section": "翻译引擎开关"
    },
    {
      "key": "enableOpenAI",
      "label": "启用 OpenAI 通用协议大模型翻译",
      "type": "boolean",
      "defaultValue": "false",
      "section": "翻译引擎开关"
    },
    {
      "key": "enableGemini",
      "label": "启用 Google Gemini 通用协议大模型翻译",
      "type": "boolean",
      "defaultValue": "false",
      "section": "翻译引擎开关"
    },
    {
      "key": "enableOllama",
      "label": "启用本地 Ollama 大模型翻译",
      "type": "boolean",
      "defaultValue": "false",
      "section": "翻译引擎开关"
    },
    {
      "key": "openaiBaseUrl",
      "label": "OpenAI 协议 Base URL",
      "type": "text",
      "defaultValue": "https://api.openai.com/v1",
      "placeholder": "https://api.openai.com/v1 或兼容中转/DeepSeek 地址",
      "helpText": "自动补全 /chat/completions；如填完整接口地址则直接使用",
      "section": "OpenAI 通用协议配置"
    },
    {
      "key": "openaiApiKey",
      "label": "OpenAI 协议 API Key",
      "type": "secret",
      "defaultValue": "",
      "placeholder": "sk-...",
      "helpText": "由 Lucent 加密保存在本地保险库；本地无鉴权接口可留空",
      "section": "OpenAI 通用协议配置"
    },
    {
      "key": "openaiModel",
      "label": "OpenAI 协议模型名称",
      "type": "text",
      "defaultValue": "gpt-4o-mini",
      "placeholder": "gpt-4o-mini / deepseek-chat / qwen-plus",
      "section": "OpenAI 通用协议配置"
    },
    {
      "key": "openaiPrompt",
      "label": "自定义翻译提示词（可选）",
      "type": "text",
      "defaultValue": "",
      "placeholder": "留空使用默认专业提示词；支持 {{target}} 占位符",
      "section": "OpenAI 通用协议配置"
    },
    {
      "key": "geminiBaseUrl",
      "label": "Google Gemini Base URL",
      "type": "text",
      "defaultValue": "https://generativelanguage.googleapis.com",
      "placeholder": "https://generativelanguage.googleapis.com 或自定义反代地址",
      "helpText": "自动拼接 /v1beta/models/{model}:generateContent",
      "section": "Google Gemini 协议配置"
    },
    {
      "key": "geminiApiKey",
      "label": "Google Gemini API Key",
      "type": "secret",
      "defaultValue": "",
      "placeholder": "AIza...",
      "helpText": "由 Lucent 加密保存在本地保险库",
      "section": "Google Gemini 协议配置"
    },
    {
      "key": "geminiModel",
      "label": "Google Gemini 模型名称",
      "type": "text",
      "defaultValue": "gemini-2.5-flash",
      "placeholder": "gemini-2.5-flash / gemini-2.5-pro",
      "section": "Google Gemini 协议配置"
    },
    {
      "key": "geminiPrompt",
      "label": "自定义翻译提示词（可选）",
      "type": "text",
      "defaultValue": "",
      "placeholder": "留空使用默认专业提示词；支持 {{target}} 占位符",
      "section": "Google Gemini 协议配置"
    },
    {
      "key": "ollamaBaseUrl",
      "label": "本地 Ollama 服务地址",
      "type": "text",
      "defaultValue": "http://127.0.0.1:11434",
      "placeholder": "http://127.0.0.1:11434",
      "section": "本地 Ollama 配置"
    },
    {
      "key": "llmModel",
      "label": "本地 Ollama 模型名称",
      "type": "text",
      "defaultValue": "qwen2.5:7b",
      "placeholder": "qwen2.5:7b / llama3.2",
      "section": "本地 Ollama 配置"
    },
    {
      "key": "exportDir",
      "label": "Anki 卡片与 CSV 导出目录",
      "type": "directory",
      "defaultValue": "~/Downloads",
      "section": "生词本与导出"
    }
  ],
  "locales": {
    "en": {
      "name": "Translate Hub · Youdao, Apple & LLM",
      "description": "Cross-app selection & image OCR translation with Youdao Translate (default priority), Apple Translate, OpenAI-compatible & Google Gemini LLMs, local Ollama, TTS & Anki vocabulary export",
      "categoryTag": "Translate",
      "commands": {
        "selection-translate": {
          "title": "Translate Frontmost Selection",
