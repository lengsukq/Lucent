          "label": "Custom Prompt (optional)",
          "section": "Google Gemini LLM"
        },
        "ollamaBaseUrl": {
          "label": "Local Ollama Base URL",
          "section": "Local Ollama"
        },
        "llmModel": {
          "label": "Ollama Model Name",
          "section": "Local Ollama"
        },
