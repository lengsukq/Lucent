      "keywords": [
        "声音",
        "audio presets"
      ],
      "icon": "waveform",
      "arguments": [
        "--open"
      ],
      "silentWhenHotKeyTriggered": true
    },
    {
      "id": "apply-favorite",
      "title": "切到常用音频组合",
